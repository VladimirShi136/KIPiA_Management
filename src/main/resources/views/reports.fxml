<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.Rectangle?>

<!--
  Author: vladimir_shi
  Since: 04.09.2025
  * Окно отчетов *
-->
<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/23"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kipia.management.kipia_management.controllers.ReportsController"
           VBox.vgrow="ALWAYS">
    <VBox fx:id="contentBox"
          spacing="20"
          prefWidth="1000"
          VBox.vgrow="ALWAYS">
        <!-- Заголовок отчета -->
        <HBox alignment="CENTER" spacing="10" styleClass="report-header">
            <Label text="📈" styleClass="report-icon"/>
            <Label fx:id="titleLabel" text="Сводка по приборам" styleClass="report-title"/>
        </HBox>
        <!-- Кольцевая диаграмма -->
        <StackPane fx:id="chartContainer" VBox.vgrow="ALWAYS" minHeight="300" alignment="CENTER">
            <BorderPane fx:id="chartPane" styleClass="chart-pane"/>
        </StackPane>
        <!-- Карточки статусов, 2x2 -->
        <GridPane fx:id="statusGrid" hgap="12" vgap="12" styleClass="status-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>

            <HBox fx:id="workingBar" styleClass="status-card working-card" alignment="CENTER_LEFT"
                  GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Rectangle width="12" height="12" arcWidth="6" arcHeight="6" fill="#4CAF50" styleClass="status-dot working-dot"/>
                <Label text="В работе" styleClass="status-card-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="workingLabel" text="0" styleClass="status-card-count working-count"/>
            </HBox>

            <HBox fx:id="storageBar" styleClass="status-card storage-card" alignment="CENTER_LEFT"
                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Rectangle width="12" height="12" arcWidth="6" arcHeight="6" fill="#F58352" styleClass="status-dot storage-dot"/>
                <Label text="Хранение" styleClass="status-card-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="storageLabel" text="0" styleClass="status-card-count storage-count"/>
            </HBox>

            <HBox fx:id="lostBar" styleClass="status-card lost-card" alignment="CENTER_LEFT"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Rectangle width="12" height="12" arcWidth="6" arcHeight="6" fill="#848C9B" styleClass="status-dot lost-dot"/>
                <Label text="Утерян" styleClass="status-card-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lostLabel" text="0" styleClass="status-card-count lost-count"/>
            </HBox>

            <HBox fx:id="brokenBar" styleClass="status-card broken-card" alignment="CENTER_LEFT"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Rectangle width="12" height="12" arcWidth="6" arcHeight="6" fill="#F44336" styleClass="status-dot broken-dot"/>
                <Label text="Испорчен" styleClass="status-card-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="brokenLabel" text="0" styleClass="status-card-count broken-count"/>
            </HBox>
        </GridPane>
    </VBox>
</StackPane>